#include "shaders/chunks.h"

uniform int NB_PARTICLES;

layout(std430, binding = BINDING_PREDICTED_POSITIONS) buffer PredictedPositionsBuffer
{
    vec3 predicted_positions[];
};

uint particle_get_chunk_idx(vec3 pos)
{
    uint cx = uint(pos.x) / c.chunk_size;
    uint cy = uint(pos.y) / c.chunk_size;
    uint cz = uint(pos.z) / c.chunk_size;

    if (cx >= c.nb_chunk_x)
        cx = c.nb_chunk_x - 1;
    if (cy >= c.nb_chunk_y)
        cy = c.nb_chunk_y - 1;
    if (cz >= c.nb_chunk_z)
        cz = c.nb_chunk_z - 1;

    return cx + cy * c.nb_chunk_x * c.nb_chunk_z + cz * c.nb_chunk_x;
}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= NB_PARTICLES)
        return;

    pairs[idx].chunk_idx = particle_get_chunk_idx(predicted_positions[idx]);
    pairs[idx].particle_idx = idx;
}
