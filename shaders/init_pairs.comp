#include "shaders/chunks.h"

uniform int NB_PARTICLES;
uniform int N2;

layout(std430, binding = BINDING_PREDICTED_POSITIONS) buffer PredictedPositionsBuffer
{
    vec2 predicted_positions[];
};

uint particle_get_chunk_idx(vec2 pos)
{
    int cx = int(floor(pos.x / float(c.chunk_size)));
    int cy = int(floor(pos.y / float(c.chunk_size)));

    cx = clamp(cx, 0, c.nb_chunk_x - 1);
    cy = clamp(cy, 0, c.nb_chunk_y - 1);

    return uint(cy) * uint(c.nb_chunk_x) + uint(cx);
}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= N2)
        return;

    if (i >= NB_PARTICLES)
    {
        pairs[i].chunk_idx    = 0xFFFFFFFFu;
        pairs[i].particle_idx = 0xFFFFFFFFu;
        return;
    }

    pairs[i].chunk_idx    = particle_get_chunk_idx(predicted_positions[i]);
    pairs[i].particle_idx = uint(i);
}
