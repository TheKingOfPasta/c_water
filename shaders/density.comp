#include "shaders/particle.glsl"
#include "shaders/chunks.h"

layout(std430, binding = BINDING_PREDICTED_POSITIONS) buffer PredictedPositionsBuffer
{
    vec3 predicted_positions[];
};
layout(std430, binding = BINDING_DENSITIES) buffer DensitiesBuffer
{
    float densities[];
};

uniform int NB_PARTICLES;

float particle_density(float d)
{
    float v = c.particle_influence_radius - d;

    if (v < 0)
        return 0;

    float scale = 15.0 / (2.0 * 3.14159265359 * pow(c.particle_influence_radius, 5));

    return v * v * scale;
}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= NB_PARTICLES)
        return;

    float d = 0.0f;
    vec3 pos = predicted_positions[idx];

    int radius = 1;

    int cx = (int(pos.x) / c.chunk_size < 0 ? 0 : int(pos.x) / c.chunk_size >= c.nb_chunk_x ? c.nb_chunk_x - 1 : int(pos.x) / c.chunk_size);
    int cy = (int(pos.y) / c.chunk_size < 0 ? 0 : int(pos.y) / c.chunk_size >= c.nb_chunk_y ? c.nb_chunk_y - 1 : int(pos.y) / c.chunk_size);

    for (int dx = -radius; dx <= radius; dx++)
        for (int dy = -radius; dy <= radius; dy++)
        {
            if (cx + dx < 0 || cy + dy < 0 || cx + dx >= c.nb_chunk_x || cy + dy >= c.nb_chunk_y)
                continue;

            int nx = cx + dx;
            int ny = cy + dy;
            int start = start_chunks[nx + ny * c.nb_chunk_x];
			if (start >= NB_PARTICLES)
				continue;
            int chunk_idx = pairs[start].chunk_idx;

            for (int i = start; i < NB_PARTICLES && pairs[i].chunk_idx == chunk_idx; i++)
            {
                float dist = length(pos - predicted_positions[pairs[i].particle_idx]);
                d += particle_density(dist);
            }
        }

    densities[idx] = d;
}
