#include "shaders/particle.glsl"
#include "shaders/chunks.h"

layout(std430, binding = BINDING_PREDICTED_POSITIONS) buffer PredictedPositionsBuffer
{
    vec3 predicted_positions[];
};
layout(std430, binding = BINDING_DENSITIES) buffer DensitiesBuffer
{
    float densities[];
};
layout(std430, binding = BINDING_EXISTENCE_FIELD) buffer ExistenceFieldBuffer
{
    uint existence_field[];
};

uniform uint NB_PARTICLES;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= c.nb_chunk_x * c.nb_chunk_y * c.nb_chunk_z)
        return;

    uint cx = idx % c.nb_chunk_x;
    uint cy = idx / (c.nb_chunk_x * c.nb_chunk_z);
    uint cz = (idx / c.nb_chunk_x) % c.nb_chunk_z;

    float r2 = c.particle_influence_radius * c.particle_influence_radius;
    vec3 chunk_min = vec3(float(cx), float(cy), float(cz)) * float(c.chunk_size);
    vec3 chunk_max = chunk_min + float(c.chunk_size);

    int radius = 2;

    for (int dx = -radius; dx <= radius; dx++)
        for (int dy = -radius; dy <= radius; dy++)
            for (int dz = -radius; dz <= radius; dz++)
            {
                if ((cx == 0 && dx < 0) || (cy == 0 && dy < 0) || (cz == 0 && dz < 0))
                    continue;

                uint nx = cx + uint(dx);
                uint ny = cy + uint(dy);
                uint nz = cz + uint(dz);

                if (nx >= c.nb_chunk_x || ny >= c.nb_chunk_y || nz >= c.nb_chunk_z)
                    continue;

                uint start = start_chunks[nx + ny * c.nb_chunk_x * c.nb_chunk_z + nz * c.nb_chunk_x];
                if (start == uint(-1) || start >= NB_PARTICLES)
                    continue;

                uint chunk_idx = pairs[start].chunk_idx;

                for (uint i = start; i < NB_PARTICLES && pairs[i].chunk_idx == chunk_idx; i++)
                {
                    vec3 ppos = particles[pairs[i].particle_idx].pos;
                    vec3 nearest = clamp(ppos, chunk_min, chunk_max);
                    vec3 diff = ppos - nearest;
                    if (dot(diff, diff) < r2)
                    {
                        existence_field[idx] = 1;
                        return;
                    }
                }
            }

    existence_field[idx] = 0;
}
