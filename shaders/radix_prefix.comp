layout(std430, binding = BINDING_RADIX_HISTOGRAM) buffer HistogramBuffer
{
    uint histogram[256];
};

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint sum = 0u;
    for (uint i = 0u; i < 256u; i++)
    {
        uint c = histogram[i];
        histogram[i] = sum;
        sum += c;
    }
}
